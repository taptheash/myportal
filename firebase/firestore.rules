rules_version = '2';

// Published in the Firebase console: Firestore Database -> Rules -> Publish.
// (This project doesn't use the Firebase CLI; keep this file in sync with
// what's published there.)
//
// The Firebase web config is public by design, so these rules are what keep
// the data private: only Doug's verified Google account can read or write,
// and only its own users/{uid}/appState/{key} documents. Everything else is
// denied.
service cloud.firestore {
  match /databases/{database}/documents {
    match /users/{userId}/appState/{key} {
      allow read, write: if request.auth != null
        && request.auth.uid == userId
        && request.auth.token.email == 'taptheash@gmail.com'
        && request.auth.token.email_verified == true;
    }
  }
}
